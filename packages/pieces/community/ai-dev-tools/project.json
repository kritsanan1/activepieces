{
  "name": "ai-dev-tools",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/pieces/community/ai-dev-tools/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/pieces/community/ai-dev-tools",
        "tsConfig": "packages/pieces/community/ai-dev-tools/tsconfig.lib.json",
        "packageJson": "packages/pieces/community/ai-dev-tools/package.json",
        "main": "packages/pieces/community/ai-dev-tools/src/index.ts",
        "assets": ["packages/pieces/community/ai-dev-tools/*.md"],
        "buildableProjectDepsInPackageJsonType": "library",
        "updateBuildableProjectDepsInPackageJson": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/pieces/community/ai-dev-tools/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/pieces/community/ai-dev-tools/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}